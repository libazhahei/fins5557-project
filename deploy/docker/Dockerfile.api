FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/quant packages/quant
COPY apps/api apps/api
RUN pip install --no-cache-dir uv && uv sync --package quant-lab-api --no-dev
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8080
CMD ["uvicorn", "quant_lab_api.main:app", "--host", "0.0.0.0", "--port", "8080"]
