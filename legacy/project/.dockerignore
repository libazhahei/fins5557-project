# VCS / local env
.git
.gitignore
.env
.venv
venv
.python-version

# Python junk
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
*.egg-info

# Ephemeral SQLite — recreated inside container
data/workspaces.db

# cache/ — only precomputed is needed at build time; everything else is generated at runtime
!cache/precomputed/SPY_*.parquet
!cache/precomputed/QQQ_*.parquet
!cache/precomputed/manifest.json
!cache/precomputed/grid_results.parquet
!cache/precomputed/runs/spy*/
!cache/precomputed/runs/custom_20*/
cache/

# Optional local mirrors / caches not needed in production
data/precomputed/

# Training output artifacts (not needed in container)
example_runs/

# Temporary scripts
aaaaa.py
tempCodeRunnerFile.py

# IDE / editor
.vscode/
.idea/
