# Copy to .env for local development

ENVIRONMENT=local
# SQLite default (no Docker required). For Postgres:
# DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quantlab
DATABASE_URL=sqlite+pysqlite:///./var/quantlab.db
OBJECT_STORE_URI=local://./var/objects

SERVICE_SHARED_SECRET=dev-shared-secret-change-me
INVITE_CODE=quant-lab-invite
JWT_SECRET=dev-jwt-secret-change-me

CORS_ORIGINS=http://localhost:5173
AGENT_BASE_URL=http://localhost:8081
API_BASE_URL=http://localhost:8080
JOB_SYNC_DEFAULT=true

# LLM — Gemini primary / lite; DeepSeek via Pi + OpenAI-compatible fallback
LLM_DEFAULT_PROVIDER=google
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_LITE_MODEL=gemini-3.1-flash-lite
LLM_DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
LLM_API_KEY=
DEEPSEEK_API_KEY=
